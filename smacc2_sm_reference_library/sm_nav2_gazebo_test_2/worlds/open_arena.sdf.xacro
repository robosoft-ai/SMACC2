<?xml version="1.0"?>
<!--
  Open arena world for sm_nav2_gazebo_test_2: a 10 x 8 m rectangular room with
  boundary walls and NO interior obstacles. The walls give AMCL laser features to
  localize against while leaving the whole interior free for the radial undo
  pattern. Matches maps/open_arena.yaml.
-->
<sdf version="1.6" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="headless" default="true"/>

  <world name="default">
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
  <xacro:unless value="$(arg headless)">
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
  </xacro:unless>
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin
      filename="gz-sim-imu-system"
      name="gz::sim::systems::Imu">
    </plugin>

    <light name='sun' type='directional'>
        <cast_shadows>0</cast_shadows>
        <pose>0 0 10 0 0 0</pose>
        <diffuse>0.8 0.8 0.8 1</diffuse>
        <specular>0.8 0.8 0.8 1</specular>
        <attenuation>
            <range>1000</range>
            <constant>0.9</constant>
            <linear>0.01</linear>
            <quadratic>0.001</quadratic>
        </attenuation>
        <direction>-0.5 0.1 -0.9</direction>
    </light>
    <model name='ground_plane'>
        <static>1</static>
        <link name='link'>
            <collision name='collision'>
                <geometry>
                    <plane>
                        <normal>0 0 1</normal>
                        <size>100 100</size>
                    </plane>
                </geometry>
                <max_contacts>10</max_contacts>
            </collision>
            <visual name='visual'>
                <geometry>
                    <plane>
                        <normal>0 0 1</normal>
                        <size>100 100</size>
                    </plane>
                </geometry>
                <material>
                    <ambient>0.8 0.8 0.8 1</ambient>
                    <diffuse>0.8 0.8 0.8 1</diffuse>
                    <specular>0.8 0.8 0.8 1</specular>
                </material>
            </visual>
        </link>
    </model>

    <scene>
      <shadows>0</shadows>
    </scene>

    <physics name='3ms' type='ode'>
        <max_step_size>0.003</max_step_size>
        <real_time_factor>1</real_time_factor>
    </physics>

    <!-- Rectangular arena: interior x in [-5, 5], y in [-4, 4], wall height 0.5 -->
    <model name="arena_walls">
      <static>1</static>
      <link name="walls">
        <collision name="north_collision">
          <pose>0 4.075 0.25 0 0 0</pose>
          <geometry><box><size>10.3 0.15 0.5</size></box></geometry>
        </collision>
        <visual name="north_visual">
          <pose>0 4.075 0.25 0 0 0</pose>
          <geometry><box><size>10.3 0.15 0.5</size></box></geometry>
          <material>
            <ambient>0.4 0.4 0.4 1</ambient>
            <diffuse>0.4 0.4 0.4 1</diffuse>
          </material>
        </visual>
        <collision name="south_collision">
          <pose>0 -4.075 0.25 0 0 0</pose>
          <geometry><box><size>10.3 0.15 0.5</size></box></geometry>
        </collision>
        <visual name="south_visual">
          <pose>0 -4.075 0.25 0 0 0</pose>
          <geometry><box><size>10.3 0.15 0.5</size></box></geometry>
          <material>
            <ambient>0.4 0.4 0.4 1</ambient>
            <diffuse>0.4 0.4 0.4 1</diffuse>
          </material>
        </visual>
        <collision name="east_collision">
          <pose>5.075 0 0.25 0 0 0</pose>
          <geometry><box><size>0.15 8.0 0.5</size></box></geometry>
        </collision>
        <visual name="east_visual">
          <pose>5.075 0 0.25 0 0 0</pose>
          <geometry><box><size>0.15 8.0 0.5</size></box></geometry>
          <material>
            <ambient>0.4 0.4 0.4 1</ambient>
            <diffuse>0.4 0.4 0.4 1</diffuse>
          </material>
        </visual>
        <collision name="west_collision">
          <pose>-5.075 0 0.25 0 0 0</pose>
          <geometry><box><size>0.15 8.0 0.5</size></box></geometry>
        </collision>
        <visual name="west_visual">
          <pose>-5.075 0 0.25 0 0 0</pose>
          <geometry><box><size>0.15 8.0 0.5</size></box></geometry>
          <material>
            <ambient>0.4 0.4 0.4 1</ambient>
            <diffuse>0.4 0.4 0.4 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
