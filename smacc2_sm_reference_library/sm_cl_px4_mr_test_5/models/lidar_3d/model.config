<?xml version="1.0"?>
<model>
  <name>lidar_3d</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>Brett Aldrich</name>
    <email>brett@robosoft.ai</email>
  </author>
  <description>
    Spherical 3D gpu_lidar (360 x 181 rays, 1 deg, 0.2-35 m, 10 Hz) for sm_cl_px4_mr_test_5.
    Derived from px4-ros2-drone-nav's lidar_3d_v1. Publishes gz topic /lidar_3d/points
    (gz.msgs.PointCloudPacked) in frame lidar_link.
  </description>
</model>
