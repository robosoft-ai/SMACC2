<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sm_cl_px4_mr_test_5</name>
  <version>3.1.0</version>
  <description>PX4 multirotor cave flight: an x500 with a 3D lidar flies into the DARPA SubT Cave Circuit Practice 01 world and back, the point cloud bridged to ROS 2 and shown in RViz, the flight gated by the lidar (obstacle hold, cloud watchdog)</description>
  <maintainer email="brett@robosoft.ai">Brett Aldrich</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>smacc2</depend>
  <depend>cl_px4_mr</depend>
  <depend>cl_generic_sensor</depend>
  <depend>px4_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>rclcpp</depend>

  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>tf2_ros_py</exec_depend>
  <exec_depend>sensor_msgs_py</exec_depend>
  <exec_depend>python3-transforms3d</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
